---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="The requested page could not be found." canonical="/404">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h1 class="text-5xl font-bold text-[#1e293b]">404</h1>
    <p class="mt-4 text-xl text-slate-600">This page could not be found.</p>
    <div class="mt-8">
      <a href="/" class="inline-flex items-center rounded-md bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-700">Go home</a>
    </div>
  </div>
</Layout>
