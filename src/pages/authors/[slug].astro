---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAuthors, getAuthorBySlug } from '../../data/adapter';
import { BreadcrumbList, ProfilePage } from '../../lib/jsonld';
import site from '../../content/config/site.json';

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.filter((a) => a.is_public).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const author = await getAuthorBySlug(slug);
if (!author || !author.is_public) return Astro.redirect('/404');

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: author.name, href: `/authors/${author.slug}/` },
];

const jsonLd = [BreadcrumbList(breadcrumbs), ProfilePage(author, site)];
---
<Layout title={author.name} description={author.bio} canonical={`/authors/${author.slug}`} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
    <article class="py-10">
      <h1 class="text-4xl font-bold text-[#1e293b]">{author.name}</h1>
      <p class="mt-2 text-lg text-orange-600">{author.role}</p>
      <p class="mt-6 text-lg text-slate-700">{author.bio}</p>
      {author.credentials && (
        <div class="mt-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Credentials</h2>
          <p class="mt-1 text-slate-700">{author.credentials}</p>
        </div>
      )}
      {author.conflicts && (
        <div class="mt-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Conflicts of interest</h2>
          <p class="mt-1 text-slate-700">{author.conflicts}</p>
        </div>
      )}
    </article>
  </div>
</Layout>
