---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StatusMatrix from '../../components/StatusMatrix';
import Timeline from '../../components/Timeline';
import SourceList from '../../components/SourceList';
import FaqAccordion from '../../components/FaqAccordion';
import NewsletterForm from '../../components/NewsletterForm';
import DisclaimerBanner from '../../components/DisclaimerBanner.astro';
import { getSubstances, getSubstanceBySlug, getDocuments, getJurisdictions, getAuthors } from '../../data/adapter';
import { BreadcrumbList } from '../../lib/jsonld';
import site from '../../content/config/site.json';

export async function getStaticPaths() {
  const substances = await getSubstances();
  return substances.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const substance = await getSubstanceBySlug(slug);
if (!substance) return Astro.redirect('/404');

const [documents, jurisdictions, authors] = await Promise.all([
  getDocuments(),
  getJurisdictions(),
  getAuthors(),
]);

const relatedDocs = documents.filter((d) => substance.document_ids.includes(d.id));
const reviewer = authors.find((a) => a.id === substance.reviewer_id);
const primary = substance.status_assertions[0];
const oneSentence = primary
  ? `${substance.canonical_name} is currently ${primary.status_label.toLowerCase()} for ${primary.activity.toLowerCase()}.`
  : `${substance.canonical_name} status is under review.`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Substances', href: '/substances' },
  { label: substance.canonical_name, href: `/substances/${substance.slug}/` },
];

const jsonLd = [
  BreadcrumbList(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: substance.canonical_name,
    description: substance.identity_notes,
    url: `${site.url}/substances/${substance.slug}/`,
  },
];
---
<Layout title={substance.canonical_name} description={substance.identity_notes} canonical={`/substances/${substance.slug}`} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
    <article class="py-8">
      <h1 class="text-4xl font-bold text-ink">{substance.canonical_name}</h1>
      {substance.synonyms.length > 0 && (
        <p class="mt-2 text-ink-muted">Also known as: {substance.synonyms.join(', ')}</p>
      )}
      <p class="mt-6 text-lg font-medium text-stamp-green bg-stamp-green-bg border border-stamp-green/20 rounded-sm p-4">{oneSentence}</p>
      <DisclaimerBanner />
      <p class="mt-6 text-ink-muted">{substance.identity_notes}</p>

      <StatusMatrix client:visible substance={substance} documents={relatedDocs} jurisdictions={jurisdictions} />

      <section class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-xl font-bold text-ink">What this means</h2>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {substance.status_assertions.map((a) => (
              <li class="flex gap-2"><span class="text-stamp-green">✓</span> {a.activity}: {a.status_label}. {a.qualification}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-xl font-bold text-ink">What this does not mean</h2>
          <ul class="mt-3 space-y-2 text-ink-muted">
            <li class="flex gap-2"><span class="text-accent">✗</span> Status in one jurisdiction does not automatically apply elsewhere.</li>
            <li class="flex gap-2"><span class="text-accent">✗</span> An approved active ingredient is not the same as an approved finished product.</li>
            <li class="flex gap-2"><span class="text-accent">✗</span> “Research use” labeling does not make an unapproved drug lawful for human use.</li>
          </ul>
        </div>
      </section>

      <Timeline client:visible events={substance.timeline} documents={relatedDocs} />
      <SourceList client:visible sources={relatedDocs} title="Controlling sources" />

      {substance.faq_items && substance.faq_items.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Frequently asked questions</h2>
          <FaqAccordion client:visible items={substance.faq_items} />
        </section>
      )}

      <div class="card mt-10 p-5 text-sm text-ink-muted flex flex-wrap gap-6">
        <div>Last verified: <span class="font-medium text-ink">{substance.last_verified}</span></div>
        <div>Reviewer: <span class="font-medium text-ink">{reviewer?.name || substance.reviewer_id}</span></div>
        <div>Next review: <span class="font-medium text-ink">{substance.next_review_at}</span></div>
      </div>

      <div class="mt-10">
        <NewsletterForm client:load />
      </div>
    </article>
  </div>
</Layout>
