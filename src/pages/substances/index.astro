---
import Layout from '../../layouts/Layout.astro';
import SubstanceExplorer from '../../components/SubstanceExplorer';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getSubstances } from '../../data/adapter';
import { ItemList } from '../../lib/jsonld';
import site from '../../content/config/site.json';

const substances = await getSubstances();

const listLd = ItemList(substances.map((s) => ({
  name: s.canonical_name,
  url: `${site.url}/substances/${s.slug}/`,
  description: s.identity_notes,
})));
---
<Layout title="Substance Status" description="Source-linked peptide status tracker: FDA approval, compounding, shortages, sport rules, and enforcement." canonical="/substances" jsonLd={listLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Substances', href: '/substances' }]} />
    <div class="py-10">
      <h1 class="text-3xl md:text-4xl font-bold text-ink">Substance status</h1>
      <p class="mt-3 text-ink-muted max-w-3xl">Search, filter by regulatory status, and compare peptides side-by-side. Each record shows controlling sources, as-of dates, and what the status does and does not mean.</p>
      <div class="mt-8">
        <SubstanceExplorer client:load substances={substances} />
      </div>
    </div>
  </div>
</Layout>
