---
import Layout from '../layouts/Layout.astro';
import SubstanceCard from '../components/SubstanceCard.astro';
import UpdateCard from '../components/UpdateCard.astro';
import ClaimCard from '../components/ClaimCard.astro';
import NewsletterForm from '../components/NewsletterForm';
import SearchModal from '../components/SearchModal';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../content/config/site.json';
import { getSubstances, getRules, getPublishedUpdates, getClaimChecks, getTrackers, getDocuments, getJurisdictions } from '../data/adapter';
import { ItemList } from '../lib/jsonld';

const [substances, rules, updates, claims, trackers, documents, jurisdictions] = await Promise.all([
  getSubstances(),
  getRules(),
  getPublishedUpdates(),
  getClaimChecks(),
  getTrackers(),
  getDocuments(),
  getJurisdictions(),
]);

const latestUpdates = updates.slice(0, 5);
const popularSubstances = substances.slice(0, 10);
const latestClaims = claims.slice(0, 4);
const featuredTrackers = trackers.slice(0, 3);

const searchIndex = [
  ...substances.map((s) => ({ type: 'substance' as const, title: s.canonical_name, href: `/substances/${s.slug}/`, description: s.identity_notes })),
  ...rules.map((r) => ({ type: 'rule' as const, title: r.name, href: `/rules/${r.slug}/`, description: r.direct_answer })),
  ...updates.map((u) => ({ type: 'update' as const, title: u.title, href: `/updates/${u.slug}/`, description: u.dek })),
  ...claims.map((c) => ({ type: 'claim' as const, title: c.title, href: `/claim-check/${c.slug}/`, description: c.claim })),
  ...documents.map((d) => ({ type: 'document' as const, title: d.title, href: `/documents/${d.slug}/`, description: d.plain_language_summary })),
  ...jurisdictions.map((j) => ({ type: 'jurisdiction' as const, title: j.name, href: `/jurisdictions/${j.slug}/`, description: j.summary })),
];

const listLd = ItemList([
  ...popularSubstances.map((s) => ({ name: s.canonical_name, url: `${site.url}/substances/${s.slug}/`, description: s.identity_notes })),
]);
---
<Layout title={site.name} description={site.description} canonical="/" jsonLd={listLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} />
    <section class="py-12 md:py-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-ink">{site.name}</h1>
        <p class="mt-4 text-xl text-ink-muted">{site.tagline}</p>
        <div class="mt-6 flex items-center gap-3">
          <SearchModal client:load index={searchIndex} />
          <a href="/substances" class="inline-flex items-center rounded-sm bg-ink px-4 py-2 text-sm font-semibold text-white hover:bg-ink-muted">Browse substances</a>
        </div>
      </div>
    </section>

    <section class="py-10 border-t border-hairline">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-ink">Latest updates</h2>
        <a href="/updates" class="text-sm font-medium text-accent hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestUpdates.map((u) => <UpdateCard update={u} />)}
      </div>
    </section>

    <section class="py-10 border-t border-hairline">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-ink">Popular substances</h2>
        <a href="/substances" class="text-sm font-medium text-accent hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {popularSubstances.map((s) => <SubstanceCard substance={s} />)}
      </div>
    </section>

    <section class="py-10 border-t border-hairline">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-ink">Claim check</h2>
        <a href="/claim-check" class="text-sm font-medium text-accent hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestClaims.map((c) => <ClaimCard claim={c} />)}
      </div>
    </section>

    <section class="py-10 border-t border-hairline">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-ink">Trackers</h2>
        <a href="/trackers" class="text-sm font-medium text-accent hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredTrackers.map((t) => (
          <a href={`/trackers/${t.slug}/`} class="card p-5">
            <h3 class="font-semibold text-ink">{t.name}</h3>
            <p class="mt-2 text-sm text-ink-muted line-clamp-3">{t.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="py-10 border-t border-hairline">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-2xl font-bold text-ink">What the Rulebook covers</h2>
          <ul class="mt-4 space-y-3 text-ink-muted">
            <li class="flex gap-3"><span class="text-stamp-green">✓</span> FDA approval, compounding, and shortage status for peptides</li>
            <li class="flex gap-3"><span class="text-stamp-green">✓</span> Jurisdiction-specific rules and enforcement actions</li>
            <li class="flex gap-3"><span class="text-stamp-green">✓</span> Source-linked updates with controlling documents</li>
            <li class="flex gap-3"><span class="text-stamp-green">✓</span> Plain-language claim checks on common misconceptions</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-ink">Methodology</h2>
          <p class="mt-4 text-ink-muted">Every status assertion is tied to a controlling source, reviewed by a qualified regulatory reviewer, and dated. We distinguish between an approved drug product, an active ingredient, compounding exemptions, and sport-rule prohibitions.</p>
          <a href="/about/status-methodology" class="mt-4 inline-block text-sm font-medium text-accent hover:underline">Read our status methodology →</a>
        </div>
      </div>
    </section>

    <section class="py-10 border-t border-hairline">
      <NewsletterForm client:load />
    </section>
  </div>
</Layout>
