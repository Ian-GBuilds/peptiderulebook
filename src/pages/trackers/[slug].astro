---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceList from '../../components/SourceList';
import { getTrackers, getTrackerBySlug, getDocuments } from '../../data/adapter';
import { BreadcrumbList, Dataset } from '../../lib/jsonld';
import TrackerExport from '../../components/TrackerExport';
import DisclaimerBanner from '../../components/DisclaimerBanner.astro';
import site from '../../content/config/site.json';

export async function getStaticPaths() {
  const trackers = await getTrackers();
  return trackers.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const tracker = await getTrackerBySlug(slug);
if (!tracker) return Astro.redirect('/404');

const documents = await getDocuments();
const relatedDocs = documents.filter((d) => tracker.source_ids.includes(d.id));

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Trackers', href: '/trackers' },
  { label: tracker.name, href: `/trackers/${tracker.slug}/` },
];

const jsonLd = [BreadcrumbList(breadcrumbs), Dataset(tracker, site)];
---
<Layout title={tracker.name} description={tracker.description} canonical={`/trackers/${tracker.slug}`} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
    <article class="py-8">
      <h1 class="text-4xl font-bold text-ink">{tracker.name}</h1>
      <p class="mt-4 text-lg text-ink-muted">{tracker.description}</p>
      <DisclaimerBanner />
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <TrackerExport client:load rows={tracker.rows} columns={tracker.columns} name={tracker.slug} />
      </div>

      <div class="mt-8 overflow-x-auto rounded-sm border border-hairline">
        <table class="min-w-full text-sm" aria-label={tracker.name}>
          <caption class="sr-only">{tracker.description}</caption>
          <thead class="bg-ground text-left text-xs font-semibold uppercase tracking-wider text-ink-muted">
            <tr>
              {tracker.columns.map((col) => (
                <th class="px-4 py-3">{col.label}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-paper">
            {tracker.rows.map((row) => (
              <tr>
                {tracker.columns.map((col) => (
                  <td class="px-4 py-3 text-ink-muted">{row[col.key]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <SourceList client:visible sources={relatedDocs} title="Sources" />

      <div class="card mt-10 p-5 text-sm text-ink-muted flex flex-wrap gap-6">
        <div>Last updated: <span class="font-medium text-ink">{tracker.last_updated}</span></div>
        <div>Next update: <span class="font-medium text-ink">{tracker.next_update_at}</span></div>
      </div>
    </article>
  </div>
</Layout>
