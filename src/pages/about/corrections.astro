---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<Layout title="Corrections" description="Corrections and updates to Peptide Rulebook content." canonical="/about/corrections">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about' }, { label: 'Corrections', href: '/about/corrections' }]} />
    <div class="py-10 prose prose-slate max-w-none">
      <h1 class="text-4xl font-bold text-[#1e293b]">Corrections</h1>
      <p>We correct factual errors promptly and transparently. Each correction includes the date, the affected page, and the nature of the fix.</p>
      <p>There are no published corrections at this time. To report an error, please <a href="/contact">contact us</a>.</p>
    </div>
  </div>
</Layout>
