---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedArticles, ARTICLE_CATEGORIES } from '../../data/articles';
const articles = await getPublishedArticles();
---
<Layout title="Articles" description="Source-linked reporting and explainers on peptide regulation, compounding, approvals, and enforcement." canonical="/articles/">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Articles', href: '/articles/' }]} />
    <section class="py-10">
      <h1 class="text-3xl font-bold">Articles</h1>
      <p class="mt-4 text-ink-muted">Reporting and explainers on peptide rules, with links to the source record.</p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map(({ id, data }) => (
          <a class="card block p-6" href={`/articles/${id}/`}>
            <p class="text-xs uppercase tracking-wide text-accent">{ARTICLE_CATEGORIES[data.category]}</p>
            <h2 class="mt-2 text-xl font-bold">{data.title}</h2>
            <p class="mt-3 text-ink-muted">{data.dek}</p>
            <time class="mt-4 block text-sm text-ink-muted" datetime={data.date.toISOString()}>{data.date.toISOString().slice(0, 10)}</time>
          </a>
        ))}
      </div>
      {articles.length === 0 && <p class="mt-8 text-ink-muted">New articles will appear here after editorial review.</p>}
    </section>
  </div>
</Layout>
