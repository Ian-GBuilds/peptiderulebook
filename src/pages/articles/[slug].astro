---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedArticles, ARTICLE_CATEGORIES } from '../../data/articles';
import site from '../../content/config/site.json';
export async function getStaticPaths() {
  return (await getPublishedArticles()).map((article) => ({ params: { slug: article.id }, props: { article } }));
}
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { data, id } = article;
const { Content } = await render(article);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: data.title,
  description: data.dek, datePublished: data.date.toISOString(),
  dateModified: (data.updated ?? data.date).toISOString(),
  url: `${site.url}/articles/${id}/`, author: { '@type': 'Organization', name: site.name },
};
---
<Layout title={data.title} description={data.dek} canonical={`/articles/${id}/`} image={data.hero} type="article" jsonLd={jsonLd}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Articles', href: '/articles/' }, { label: data.title, href: `/articles/${id}/` }]} />
    <article class="py-10">
      <p class="text-sm uppercase tracking-wide text-accent">{ARTICLE_CATEGORIES[data.category]}</p>
      <h1 class="mt-3 text-3xl md:text-4xl font-bold">{data.title}</h1>
      <p class="mt-5 text-xl text-ink-muted">{data.dek}</p>
      <p class="mt-4 text-sm text-ink-muted">Published <time datetime={data.date.toISOString()}>{data.date.toISOString().slice(0, 10)}</time></p>
      {data.hero && <img class="mt-8 w-full rounded-sm" src={data.hero} alt={data.heroAlt ?? ''} />}
      <div class="article-body mt-8"><Content /></div>
      {data.sources.length > 0 && <section class="mt-10 border-t border-hairline pt-6" aria-label="Sources">
        <h2 class="text-2xl font-bold">Sources</h2>
        <ul class="mt-4 list-disc pl-6 space-y-2">{data.sources.map((source) => <li><a class="text-accent underline" href={source.url} rel="noopener noreferrer">{source.title}</a></li>)}</ul>
      </section>}
      <p class="mt-8 border-t border-hairline pt-6 text-sm text-ink-muted">For general information only; not legal or medical advice. Regulatory status depends on jurisdiction, activity, and date. Verify the controlling official record before acting.</p>
    </article>
  </div>
</Layout>
<style>
  .article-body :global(p) { margin-block: 1.25rem; line-height: 1.8; }
  .article-body :global(h2) { font-size: 1.5rem; margin-top: 2rem; }
  .article-body :global(h3) { font-size: 1.25rem; margin-top: 1.5rem; }
  .article-body :global(a) { color: var(--color-accent); text-decoration: underline; }
  .article-body :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .article-body :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .article-body :global(li) { margin-block: .5rem; }
  .article-body :global(blockquote) { border-left: 2px solid var(--color-hairline); padding-left: 1rem; }
</style>
