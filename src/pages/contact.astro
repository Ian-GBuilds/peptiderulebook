---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Layout title="Contact" description="Contact the Peptide Rulebook editorial team." canonical="/contact">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact', href: '/contact' }]} />
    <div class="py-10">
      <h1 class="text-4xl font-bold text-ink">Contact</h1>
      <p class="mt-4 text-ink-muted">For corrections, source suggestions, or media inquiries, email us at <a href="mailto:hello@peptiderulebook.com" class="text-accent hover:underline">hello@peptiderulebook.com</a>.</p>
      <p class="mt-4 text-ink-muted">We read every message. Response time varies depending on the complexity of the question.</p>
      <div class="card mt-8 p-6">
        <h2 class="text-lg font-semibold text-ink">What to include</h2>
        <ul class="mt-3 space-y-2 text-ink-muted">
          <li>• The page or substance in question</li>
          <li>• The controlling source you believe supports or contradicts our conclusion</li>
          <li>• A link or citation to the source</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
