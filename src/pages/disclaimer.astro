---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Layout title="Disclaimer" description="Disclaimer: Peptide Rulebook is not legal or medical advice." canonical="/disclaimer">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Disclaimer', href: '/disclaimer' }]} />
    <div class="py-10">
      <h1 class="text-4xl font-bold text-[#1e293b]">Disclaimer</h1>
      <p class="mt-4 text-lg text-slate-700">Peptide Rulebook is an informational reference. Nothing on this site is legal advice, medical advice, or a substitute for consulting a qualified professional and the official controlling source.</p>
      <p class="mt-4 text-slate-700">Regulatory status can change. Always verify the current official source before making compliance, prescribing, purchasing, or clinical decisions.</p>
      <p class="mt-4 text-slate-700">We are not responsible for errors or omissions. If you find one, please <a href="/contact" class="text-orange-600 hover:underline">contact us</a>.</p>
    </div>
  </div>
</Layout>
