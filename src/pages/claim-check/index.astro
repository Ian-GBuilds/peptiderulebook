---
import Layout from '../../layouts/Layout.astro';
import ClaimCardInteractive from '../../components/ClaimCardInteractive';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getClaimChecks } from '../../data/adapter';
import { ItemList } from '../../lib/jsonld';
import site from '../../content/config/site.json';

const claims = await getClaimChecks();
const listLd = ItemList(claims.map((c) => ({
  name: c.title,
  url: `${site.url}/claim-check/${c.slug}/`,
  description: c.correct_wording,
})));
---
<Layout title="Claim Check" description="Fact-checked answers to common peptide claims and misconceptions." canonical="/claim-check" jsonLd={listLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Claim Check', href: '/claim-check' }]} />
    <div class="py-10">
      <h1 class="text-3xl font-bold text-ink mb-4">Claim check</h1>
      <p class="text-ink-muted max-w-3xl">We review common claims about peptide regulation. Read the claim, form a view, then reveal the verdict and the correct wording with controlling sources.</p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        {claims.map((c) => <ClaimCardInteractive client:visible claim={c} />)}
      </div>
    </div>
  </div>
</Layout>
