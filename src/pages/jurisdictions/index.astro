---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getJurisdictions } from '../../data/adapter';
import { ItemList } from '../../lib/jsonld';
import site from '../../content/config/site.json';

const jurisdictions = await getJurisdictions();
const listLd = ItemList(jurisdictions.map((j) => ({
  name: j.name,
  url: `${site.url}/jurisdictions/${j.slug}/`,
  description: j.summary,
})));
---
<Layout title="Jurisdictions" description="Federal, state, and international jurisdictions covered by the Peptide Rulebook." canonical="/jurisdictions" jsonLd={listLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Jurisdictions', href: '/jurisdictions' }]} />
    <div class="py-10">
      <h1 class="text-3xl font-bold text-[#1e293b] mb-4">Jurisdictions</h1>
      <p class="text-slate-600 max-w-3xl">Regulatory scope and key agencies for each jurisdiction we track.</p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        {jurisdictions.map((j) => (
          <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold text-[#1e293b]">
                <a href={`/jurisdictions/${j.slug}/`} class="hover:text-orange-600 hover:underline">{j.name}</a>
              </h3>
              <span class="text-xs rounded bg-slate-100 px-2 py-1 text-slate-700 uppercase">{j.type}</span>
            </div>
            <p class="mt-2 text-sm text-slate-600 line-clamp-3">{j.summary}</p>
            {j.review_status !== 'complete' && (
              <p class="mt-3 text-xs font-medium text-amber-700">Review status: {j.review_status}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
