---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceList from '../../components/SourceList';
import { getJurisdictions, getJurisdictionBySlug, getDocuments, getSubstances } from '../../data/adapter';
import { BreadcrumbList } from '../../lib/jsonld';

export async function getStaticPaths() {
  const jurisdictions = await getJurisdictions();
  return jurisdictions.map((j) => ({ params: { slug: j.slug } }));
}

const { slug } = Astro.params;
const jurisdiction = await getJurisdictionBySlug(slug);
if (!jurisdiction) return Astro.redirect('/404');

const [documents, substances] = await Promise.all([getDocuments(), getSubstances()]);
const relatedDocs = documents.filter((d) => jurisdiction.document_ids?.includes(d.id));
const relatedSubstances = substances.filter((s) => jurisdiction.substance_slugs?.includes(s.slug));
const noindex = jurisdiction.slug === 'california';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Jurisdictions', href: '/jurisdictions' },
  { label: jurisdiction.name, href: `/jurisdictions/${jurisdiction.slug}/` },
];

const jsonLd = BreadcrumbList(breadcrumbs);
---
<Layout title={jurisdiction.name} description={jurisdiction.summary} canonical={`/jurisdictions/${jurisdiction.slug}`} noindex={noindex} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
    <article class="py-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs rounded bg-slate-100 px-2 py-1 text-slate-700 uppercase">{jurisdiction.type}</span>
        {jurisdiction.review_status !== 'complete' && (
          <span class="text-xs rounded bg-amber-100 px-2 py-1 text-amber-800 uppercase">{jurisdiction.review_status} review</span>
        )}
      </div>
      <h1 class="text-4xl font-bold text-[#1e293b]">{jurisdiction.name}</h1>
      <p class="mt-4 text-lg text-slate-700">{jurisdiction.summary}</p>
      <p class="mt-4 text-slate-600">{jurisdiction.scope_notes}</p>

      <section class="mt-10">
        <h2 class="text-xl font-bold text-[#1e293b]">Key agencies</h2>
        <ul class="mt-4 space-y-2">
          {jurisdiction.key_agencies.map((agency) => (
            <li>
              {agency.url ? (
                <a href={agency.url} target="_blank" rel="noopener noreferrer" class="text-orange-600 hover:underline">{agency.name} ↗</a>
              ) : (
                <span class="text-slate-700">{agency.name}</span>
              )}
            </li>
          ))}
        </ul>
      </section>

      {relatedSubstances.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-[#1e293b]">Substances covered</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {relatedSubstances.map((s) => (
              <a href={`/substances/${s.slug}/`} class="rounded bg-emerald-50 px-3 py-1 text-sm text-emerald-700 hover:underline">{s.canonical_name}</a>
            ))}
          </div>
        </section>
      )}

      <SourceList client:visible sources={relatedDocs} title="Key documents" />
    </article>
  </div>
</Layout>
