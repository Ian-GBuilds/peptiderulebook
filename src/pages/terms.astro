---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Layout title="Terms of Use" description="Terms of use for the Peptide Rulebook website." canonical="/terms">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Terms of Use', href: '/terms' }]} />
    <div class="py-10">
      <h1 class="text-4xl font-bold text-[#1e293b]">Terms of use</h1>
      <p class="mt-4 text-slate-700">By using Peptide Rulebook, you agree to these terms. If you do not agree, please do not use the site.</p>
      <h2 class="mt-8 text-xl font-bold text-[#1e293b]">Not legal or medical advice</h2>
      <p class="mt-2 text-slate-700">The content on this site is for informational purposes only. It is not legal, medical, or compliance advice for any specific product, prescription, or situation.</p>
      <h2 class="mt-8 text-xl font-bold text-[#1e293b]">Accuracy</h2>
      <p class="mt-2 text-slate-700">We aim for accuracy, but regulations change. Always consult the official source or a qualified professional before acting on information here.</p>
      <h2 class="mt-8 text-xl font-bold text-[#1e293b]">Intellectual property</h2>
      <p class="mt-2 text-slate-700">Original content is © Peptide Rulebook. You may link to pages and quote short excerpts with attribution.</p>
      <h2 class="mt-8 text-xl font-bold text-[#1e293b]">Liability</h2>
      <p class="mt-2 text-slate-700">Peptide Rulebook is not liable for decisions made based on information on this site.</p>
    </div>
  </div>
</Layout>
