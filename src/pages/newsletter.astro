---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm';
---
<Layout title="Newsletter" description="Get rule change alerts for peptide regulation, shortages, compounding, and enforcement." canonical="/newsletter">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Newsletter', href: '/newsletter' }]} />
    <div class="py-12">
      <h1 class="text-4xl font-bold text-[#1e293b]">Rule Change Alerts</h1>
      <p class="mt-4 text-lg text-slate-600">One email when a status changes. No marketing, no sponsored content, no unrelated noise.</p>
      <div class="mt-8">
        <NewsletterForm client:load />
      </div>
      <p class="mt-6 text-sm text-slate-500">We may use a third-party email provider. You can unsubscribe at any time. See our <a href="/privacy" class="text-orange-600 hover:underline">privacy policy</a>.</p>
    </div>
  </div>
</Layout>
