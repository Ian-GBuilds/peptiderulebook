---
import site from '../content/config/site.json';
const columns = [
  { title: 'Explore', links: site.footer_nav.filter((n) => ['Substances', 'Jurisdictions', 'Documents', 'Trackers', 'Rulebook', 'Claim Check', 'Updates'].includes(n.label)) },
  { title: 'About', links: site.footer_nav.filter((n) => ['Methodology', 'Editorial Standards', 'Corrections', 'Funding', 'About', 'Contact'].includes(n.label)) },
  { title: 'Legal', links: site.footer_nav.filter((n) => ['Disclaimer', 'Privacy', 'Terms'].includes(n.label)) },
];
---
<footer class="bg-paper border-t border-hairline mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <a href="/" class="text-xl font-bold font-serif text-ink no-underline"><span class="text-accent">Peptide</span> Rulebook</a>
        <p class="mt-3 text-sm text-ink-muted">{site.tagline}</p>
      </div>
      {columns.map((col) => (
        <div>
          <h3 class="text-xs font-mono font-semibold text-ink uppercase tracking-wider">{col.title}</h3>
          <ul class="mt-4 space-y-2">
            {col.links.map((link) => (
              <li><a href={link.href} class="text-sm text-ink-muted hover:text-ink no-underline decoration-transparent hover:decoration-accent">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-10 pt-6 border-t border-hairline text-sm text-ink-muted flex flex-col sm:flex-row justify-between gap-4">
      <p>© {new Date().getFullYear()} {site.name}. Not legal or medical advice.</p>
      <p class="font-mono text-xs uppercase tracking-wider">Last updated from source-linked records.</p>
    </div>
  </div>
</footer>
