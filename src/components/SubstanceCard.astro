---
import type { Substance } from '../data/types';
interface Props {
  substance: Substance;
}
const { substance } = Astro.props;
const primary = substance.status_assertions[0];
const summary = primary
  ? `${primary.activity}: ${primary.status_label}`
  : 'Status under review';
---
<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md transition-shadow">
  <h3 class="text-lg font-semibold text-[#1e293b]">
    <a href={`/substances/${substance.slug}/`} class="hover:text-orange-600 hover:underline">{substance.canonical_name}</a>
  </h3>
  <p class="mt-1 text-sm text-emerald-700 font-medium">{summary}</p>
  {substance.synonyms.length > 0 && (
    <p class="mt-2 text-xs text-slate-500">Also known as: {substance.synonyms.slice(0, 3).join(', ')}{substance.synonyms.length > 3 && '…'}</p>
  )}
  <p class="mt-3 text-sm text-slate-600 line-clamp-3">{substance.identity_notes}</p>
  <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
    <span>Last verified {substance.last_verified}</span>
    <a href={`/substances/${substance.slug}/`} class="text-orange-600 hover:underline">Read status →</a>
  </div>
</article>
