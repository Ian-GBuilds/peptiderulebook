---
import type { Substance } from '../data/types';
interface Props {
  substance: Substance;
}
const { substance } = Astro.props;
const primary = substance.status_assertions[0];
const summary = primary
  ? `${primary.activity}: ${primary.status_label}`
  : 'Status under review';
---
<article class="card p-5">
  <h3 class="text-lg font-semibold font-serif text-ink">
    <a href={`/substances/${substance.slug}/`} class="no-underline hover:underline decoration-accent">{substance.canonical_name}</a>
  </h3>
  <p class="mt-2 text-sm font-medium text-stamp-green">{summary}</p>
  {substance.synonyms.length > 0 && (
    <p class="mt-2 text-xs font-mono text-ink-muted">Also known as: {substance.synonyms.slice(0, 3).join(', ')}{substance.synonyms.length > 3 && '…'}</p>
  )}
  <p class="mt-3 text-sm text-ink-muted line-clamp-3">{substance.identity_notes}</p>
  <div class="mt-4 flex items-center justify-between text-xs font-mono uppercase tracking-wider text-ink-muted">
    <span>Verified {substance.last_verified}</span>
    <a href={`/substances/${substance.slug}/`} class="text-ink hover:text-accent no-underline">Read status →</a>
  </div>
</article>
