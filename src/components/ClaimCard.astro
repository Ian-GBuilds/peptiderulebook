---
import type { ClaimCheck } from '../data/types';
interface Props {
  claim: ClaimCheck;
}
const { claim } = Astro.props;

const verdictClasses: Record<string, string> = {
  accurate: 'stamp-green',
  'partly accurate': 'stamp-amber',
  misleading: 'stamp-red',
  unsupported: 'stamp-neutral',
  outdated: 'stamp-blue',
  'not verifiable': 'stamp-neutral',
};
---
<article class="card p-5">
  <div class="flex flex-wrap items-center gap-2">
    <span class={`stamp ${verdictClasses[claim.verdict] || 'stamp-neutral'}`}>{claim.verdict}</span>
    <span class="text-xs font-mono uppercase tracking-wider text-ink-muted">{claim.jurisdiction} · {claim.date}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold font-serif text-ink">
    <a href={`/claim-check/${claim.slug}/`} class="no-underline hover:underline decoration-accent">{claim.title}</a>
  </h3>
  <p class="mt-2 text-sm text-ink-muted">“{claim.claim}”</p>
  <p class="mt-2 text-sm font-medium text-stamp-green">{claim.correct_wording}</p>
</article>
