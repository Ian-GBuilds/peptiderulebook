---
import type { ClaimCheck } from '../data/types';
interface Props {
  claim: ClaimCheck;
}
const { claim } = Astro.props;

const verdictClasses: Record<string, string> = {
  accurate: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  'partly accurate': 'bg-amber-100 text-amber-800 border-amber-200',
  misleading: 'bg-orange-100 text-orange-800 border-orange-200',
  unsupported: 'bg-slate-100 text-slate-700 border-slate-200',
  outdated: 'bg-blue-100 text-blue-800 border-blue-200',
  'not verifiable': 'bg-gray-100 text-gray-700 border-gray-200',
};
---
<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md transition-shadow">
  <div class="flex flex-wrap items-center gap-2">
    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${verdictClasses[claim.verdict] || 'bg-gray-100 text-gray-700 border-gray-200'}`}>{claim.verdict}</span>
    <span class="text-xs text-slate-500">{claim.jurisdiction} · {claim.date}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-[#1e293b]">
    <a href={`/claim-check/${claim.slug}/`} class="hover:text-orange-600 hover:underline">{claim.title}</a>
  </h3>
  <p class="mt-2 text-sm text-slate-700">“{claim.claim}”</p>
  <p class="mt-2 text-sm font-medium text-emerald-700">{claim.correct_wording}</p>
</article>
