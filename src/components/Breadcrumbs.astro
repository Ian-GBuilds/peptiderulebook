---
import JsonLd from './JsonLd.astro';
import { BreadcrumbList } from '../lib/jsonld';

interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
const jsonLd = BreadcrumbList(items);
---
<nav aria-label="Breadcrumb" class="text-xs font-mono uppercase tracking-wider text-ink-muted py-4">
  <ol class="flex flex-wrap gap-2 items-center">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true" class="text-hairline">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page" class="font-medium text-ink">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-ink no-underline decoration-transparent">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
<JsonLd data={jsonLd} />
