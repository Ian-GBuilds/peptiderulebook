---
import type { Update } from '../data/types';
interface Props {
  update: Update;
}
const { update } = Astro.props;
---
<article class="card p-5">
  <div class="flex flex-wrap items-center gap-2 text-xs font-mono uppercase tracking-wider text-ink-muted">
    <time datetime={update.publication_date}>{update.publication_date}</time>
    {update.procedural_status && <span class="stamp stamp-neutral">{update.procedural_status}</span>}
  </div>
  <h3 class="mt-2 text-lg font-semibold font-serif text-ink">
    <a href={`/updates/${update.slug}/`} class="no-underline hover:underline decoration-accent">{update.title}</a>
  </h3>
  <p class="mt-2 text-sm text-ink-muted line-clamp-3">{update.dek}</p>
  {(update.affected_substance_slugs.length > 0 || update.affected_rule_slugs.length > 0) && (
    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      {update.affected_substance_slugs.map((slug) => (
        <a href={`/substances/${slug}/`} class="stamp stamp-green no-underline">{slug}</a>
      ))}
      {update.affected_rule_slugs.map((slug) => (
        <a href={`/rules/${slug}/`} class="stamp stamp-blue no-underline">{slug}</a>
      ))}
    </div>
  )}
</article>
