---
import site from '../content/config/site.json';
const nav = site.header_nav;
---
<header class="border-b border-slate-200 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-bold text-[#1e293b] tracking-tight">
        <span class="text-orange-500">Peptide</span> Rulebook
      </a>
      <nav class="hidden md:flex items-center gap-6" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-slate-700 hover:text-orange-600 transition-colors">{item.label}</a>
        ))}
      </nav>
      <details class="md:hidden group">
        <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-slate-100" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#1e293b]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div class="absolute top-16 left-0 right-0 bg-white border-b border-slate-200 shadow-sm p-4 z-50">
          <nav class="flex flex-col gap-3" aria-label="Mobile">
            {nav.map((item) => (
              <a href={item.href} class="text-base font-medium text-slate-700 hover:text-orange-600">{item.label}</a>
            ))}
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
