---
import type { Rule } from '../data/types';
interface Props {
  rule: Rule;
}
const { rule } = Astro.props;
---
<article class="card p-5">
  <h3 class="text-lg font-semibold font-serif text-ink">
    <a href={`/rules/${rule.slug}/`} class="no-underline hover:underline decoration-accent">{rule.name}</a>
  </h3>
  <p class="mt-2 text-sm text-ink-muted line-clamp-3">{rule.direct_answer}</p>
  <div class="mt-4 flex flex-wrap gap-2 text-xs">
    <span class="stamp stamp-neutral">{rule.jurisdiction}</span>
    <span class="stamp stamp-neutral">{rule.authority_type}</span>
  </div>
</article>
